rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email.lower() == 'jihadbolchi@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products collection: public read, verified admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories collection: public read, verified admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store settings (e.g. Hero Banner): public read, verified admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: guest checkout may create orders; only verified admin can read/manage them.
    // Keep public creation for the current guest checkout flow; add server-side validation
    // and abuse protection before changing this contract.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
