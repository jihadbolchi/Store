{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Art and craft supplies product listing in Dhaka Art Nook store.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique product ID" },
        "name": { "type": "string", "description": "Product display name", "maxLength": 200 },
        "slug": { "type": "string", "description": "URL slug", "maxLength": 200 },
        "categoryId": { "type": "string", "description": "Associated category ID" },
        "categoryName": { "type": "string", "description": "Associated category display name" },
        "description": { "type": "string", "description": "Detailed product description", "maxLength": 5000 },
        "price": { "type": "number", "description": "Regular price in BDT (৳)" },
        "discountPrice": { "type": "number", "description": "Optional discounted price in BDT (৳)" },
        "stock": { "type": "number", "description": "Units available in stock" },
        "inStock": { "type": "boolean", "description": "Whether product is in stock" },
        "featured": { "type": "boolean", "description": "Whether to feature on homepage" },
        "images": { "type": "array", "description": "List of product image URLs" },
        "badge": { "type": "string", "description": "Optional product badge label", "maxLength": 50 },
        "craftType": { "type": "string", "description": "Type of craft material", "maxLength": 100 },
        "createdAt": { "type": "string", "description": "ISO timestamp of product creation" }
      },
      "required": ["id", "name", "price", "stock", "inStock"]
    },
    "Category": {
      "title": "Category",
      "description": "Art and craft supply product category.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique category ID" },
        "name": { "type": "string", "description": "Category name", "maxLength": 100 },
        "slug": { "type": "string", "description": "URL slug", "maxLength": 100 },
        "description": { "type": "string", "description": "Category description", "maxLength": 1000 },
        "image": { "type": "string", "description": "Banner or thumbnail image URL" },
        "itemCount": { "type": "number", "description": "Count of items in category" }
      },
      "required": ["id", "name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details placed through WhatsApp checkout.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique order ID" },
        "orderNumber": { "type": "string", "description": "Human-readable order tracking number" },
        "createdAt": { "type": "string", "description": "ISO timestamp of order placement" },
        "customer": { "type": "object", "description": "Customer contact and delivery details" },
        "items": { "type": "array", "description": "List of ordered items" },
        "subtotal": { "type": "number", "description": "Order items subtotal in BDT" },
        "deliveryCharge": { "type": "number", "description": "Delivery fee in BDT" },
        "grandTotal": { "type": "number", "description": "Grand total in BDT" },
        "status": { "type": "string", "description": "Order fulfillment status" },
        "paymentMethod": { "type": "string", "description": "Payment channel used" },
        "notes": { "type": "string", "description": "Optional customer delivery notes" }
      },
      "required": ["id", "orderNumber", "createdAt", "customer", "items", "grandTotal", "status"]
    },
    "HeroBanner": {
      "title": "HeroBanner",
      "description": "Storefront homepage hero banner configuration.",
      "type": "object",
      "properties": {
        "imageUrl": { "type": "string", "description": "Hero banner image URL or data URI" },
        "title": { "type": "string", "description": "Main banner headline text", "maxLength": 200 },
        "subtitle": { "type": "string", "description": "Banner subtext description", "maxLength": 500 },
        "ctaText": { "type": "string", "description": "CTA button text", "maxLength": 50 },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last banner update" }
      },
      "required": ["imageUrl", "title", "subtitle", "ctaText"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Customer live chat or inquiry message.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique message ID" },
        "senderId": { "type": "string", "description": "UID of sender or guest ID" },
        "senderName": { "type": "string", "description": "Display name of sender", "maxLength": 100 },
        "senderEmail": { "type": "string", "description": "Email of sender if logged in", "maxLength": 150 },
        "text": { "type": "string", "description": "Message content", "maxLength": 2000 },
        "isAdmin": { "type": "boolean", "description": "Whether message is from store admin" },
        "createdAt": { "type": "string", "description": "ISO timestamp of message" }
      },
      "required": ["id", "senderId", "senderName", "text", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public catalog of art and craft supplies."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Art and craft material categories."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders placed by customers."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/HeroBanner" },
      "description": "Storefront configuration such as hero banner."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Customer support chat inquiries and messages."
    }
  }
}
